// Kasvo — data model. See docs/SPEC.md §3.
//
// Money is a signed BigInt in the account currency's minor unit (IDR has none), so an
// expense of Rp25.000 is stored as -25000. Balances are always derived, never stored.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  locale       String   @default("id")
  timezone     String   @default("Asia/Jakarta")
  baseCurrency String   @default("IDR")
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  sessions     Session[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  apiTokens    ApiToken[]
  pending      PendingAction[]
  imports      ImportBatch[]
  rules        Rule[]
  budgets      Budget[]
  goals        Goal[]
  debts        Debt[]
  assets       Asset[]
  attachments  Attachment[]

  @@map("users")
}

model Session {
  /// Opaque random token; also the value of the session cookie.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AccountType {
  BANK
  EWALLET
  CASH
  CREDIT_CARD
  LOAN
  INVESTMENT
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  institution    String?
  currency       String      @default("IDR")
  openingBalance BigInt      @default(0)
  openingDate    DateTime    @db.Date
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  imports      ImportBatch[]
  rules        Rule[]
  goals        Goal[]
  debts        Debt[]

  @@unique([userId, name])
  @@map("accounts")
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id         String       @id @default(cuid())
  userId     String
  name       String
  kind       CategoryKind
  parentId   String?
  color      String?
  /// Icon key from the app's curated set (see src/components/category-icons.ts).
  icon       String?
  /// Default need/want for its transactions, used by the 50/30/20 view.
  necessity  Necessity?
  archivedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  rules        Rule[]
  stagedRows   StagedRow[]
  budgets      Budget[]

  @@unique([userId, kind, name])
  @@map("categories")
}

/// Needs and wants for the 50/30/20 split; savings is what income leaves over.
enum Necessity {
  NEED
  WANT
}

enum TransactionSource {
  MANUAL
  IMPORT
  AGENT
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  accountId   String
  bookedOn    DateTime          @db.Date
  amount      BigInt
  description String
  payee       String?
  note        String?
  categoryId  String?
  /// Overrides the category's need/want for this one transaction.
  necessity   Necessity?
  transferId  String?
  importBatchId String?
  fingerprint String
  source      TransactionSource @default(MANUAL)
  /// MCP client name when an agent created the row.
  createdBy   String?
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  debtPayment DebtPayment?
  attachments Attachment[]

  @@index([userId, bookedOn])
  @@index([accountId, bookedOn])
  @@index([accountId, fingerprint])
  @@index([transferId])
  @@index([importBatchId])
  @@map("transactions")
}

enum ActorKind {
  USER
  AGENT
}

/// Every write through the domain layer leaves one row here, from the UI or an agent.
model AuditLog {
  id         String    @id @default(cuid())
  userId     String
  actorKind  ActorKind
  /// MCP client name for agents, null for the UI.
  clientName String?
  action     String
  entity     String
  entityId   String
  before     Json?
  after      Json?
  at         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Bearer token for the MCP server and API. Only a sha256 of the secret is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// First characters of the token, shown in the UI so the user can tell tokens apart.
  prefix     String
  tokenHash  String    @unique
  /// Any of "read", "write", "destructive".
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// A destructive request waiting for `kasvo_confirm`. Nothing changes until it is consumed.
model PendingAction {
  id         String    @id @default(cuid())
  userId     String
  clientName String?
  tool       String
  payload    Json
  summary    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("pending_actions")
}

enum ImportStatus {
  /// Parsed rows are waiting for review.
  STAGED
  /// The file was not recognised; the user must map its columns.
  NEEDS_MAPPING
  COMMITTED
  REVERTED
  DISCARDED
}

model ImportBatch {
  id          String       @id @default(cuid())
  userId      String
  accountId   String
  /// Detected or chosen parser, e.g. "bca", "generic", "agent".
  format      String
  fileName    String?
  fileHash    String?
  /// Original file text, kept until commit so the user can re-map columns.
  rawContent  String?
  /// Column mapping used for "generic" CSV.
  mapping     Json?
  status      ImportStatus @default(STAGED)
  rowCount    Int          @default(0)
  duplicateCount Int       @default(0)
  committedCount Int       @default(0)
  createdAt   DateTime     @default(now())
  committedAt DateTime?
  createdBy   String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rows         StagedRow[]
  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([accountId, fileHash])
  @@map("import_batches")
}

model StagedRow {
  id          String    @id @default(cuid())
  batchId     String
  /// Position in the file, for stable ordering.
  line        Int
  bookedOn    DateTime  @db.Date
  amount      BigInt
  description String
  payee       String?
  fingerprint String
  /// True when the account already holds this transaction.
  duplicate   Boolean   @default(false)
  categoryId  String?
  /// Rule that suggested categoryId, if any.
  ruleId      String?
  /// User or agent decided to leave this row out.
  skip        Boolean   @default(false)

  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([batchId, line])
  @@map("staged_rows")
}

/// "When a transaction looks like this, give it that category." First match by priority wins.
model Rule {
  id            String        @id @default(cuid())
  userId        String
  priority      Int           @default(100)
  enabled       Boolean       @default(true)
  /// Case-insensitive substring of the normalised description or payee.
  contains      String
  kind          CategoryKind?
  accountId     String?
  minAmount     BigInt?
  maxAmount     BigInt?
  categoryId    String
  /// Optional payee to set when the rule matches.
  setPayee      String?
  createdAt     DateTime      @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
  @@map("rules")
}

/// Spending limit for one expense category in one month. A parent category's budget covers its subcategories.
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  /// "YYYY-MM"
  month      String
  amount     BigInt
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}

/// A savings target. Progress is the linked account's balance, or the sum of contributions when no account is linked.
model Goal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  targetAmount BigInt
  targetDate   DateTime? @db.Date
  accountId    String?
  note         String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@unique([userId, name])
  @@map("goals")
}

/// Money set aside for a goal without a linked account. Negative amounts are withdrawals.
model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  bookedOn  DateTime @db.Date
  amount    BigInt
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, bookedOn])
  @@map("goal_contributions")
}

enum DebtDirection {
  /// The user owes someone.
  BORROWED
  /// Someone owes the user.
  LENT
}

/// A loan, instalment plan, or informal debt. The schedule is derived from the terms, never stored:
/// `instalmentCount` payments of `instalmentAmount`, monthly from `firstDueOn`. A one-off debt has a count of 1.
model Debt {
  id               String        @id @default(cuid())
  userId           String
  name             String
  direction        DebtDirection
  counterparty     String?
  principal        BigInt
  instalmentAmount BigInt
  instalmentCount  Int           @default(1)
  firstDueOn       DateTime      @db.Date
  /// Annual interest rate in basis points (1250 = 12.5%), for payoff planning only.
  annualRateBp     Int?
  /// Optional LOAN or CREDIT_CARD account; payments then become transfers into or out of it.
  accountId        String?
  note             String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payments DebtPayment[]

  @@unique([userId, name])
  @@map("debts")
}

/// One repayment. `transactionId` is the row in the user's own account, either created with the payment
/// (`ledgerCreated`) or an existing one, such as an imported bank row, linked to it.
model DebtPayment {
  id            String   @id @default(cuid())
  debtId        String
  userId        String
  paidOn        DateTime @db.Date
  amount        BigInt
  transactionId String?  @unique
  ledgerCreated Boolean  @default(false)
  note          String?
  createdAt     DateTime @default(now())

  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([debtId, paidOn])
  @@map("debt_payments")
}

enum AssetKind {
  PROPERTY
  VEHICLE
  GOLD
  STOCK
  FUND
  CRYPTO
  DEPOSIT
  PENSION
  OTHER
}

/// Something of value outside the accounts: a house, a car, gold, stocks, funds. Its value is the
/// latest valuation, or the purchase value until one is recorded.
model Asset {
  id            String    @id @default(cuid())
  userId        String
  name          String
  kind          AssetKind
  /// Grams of gold, shares, fund units, coins; null for a house or car.
  units         Decimal?  @db.Decimal(24, 8)
  /// What was paid in total.
  purchaseValue BigInt?
  purchasedOn   DateTime? @db.Date
  note          String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  valuations AssetValuation[]

  @@unique([userId, name])
  @@map("assets")
}

/// The asset's total value on a day; for unit-based assets also the price per unit.
model AssetValuation {
  id        String   @id @default(cuid())
  assetId   String
  userId    String
  valuedOn  DateTime @db.Date
  value     BigInt
  unitPrice BigInt?
  note      String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, valuedOn])
  @@map("asset_valuations")
}

/// A receipt, invoice, or proof of transfer kept with a transaction. Stored in the database so a
/// single backup holds everything; photos are shrunk in the browser before upload.
model Attachment {
  id            String   @id @default(cuid())
  userId        String
  transactionId String
  fileName      String
  /// Sniffed from the bytes, never taken from the upload: image/jpeg, image/png, image/webp, application/pdf.
  mimeType      String
  size          Int
  sha256        String
  data          Bytes
  /// MCP client name when an agent attached it.
  createdBy     String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("attachments")
}
