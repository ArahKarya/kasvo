// Kasvo — data model. See docs/SPEC.md §3.
//
// Money is a signed BigInt in the account currency's minor unit (IDR has none), so an
// expense of Rp25.000 is stored as -25000. Balances are always derived, never stored.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  locale       String   @default("id")
  timezone     String   @default("Asia/Jakarta")
  baseCurrency String   @default("IDR")
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  sessions     Session[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  apiTokens    ApiToken[]
  pending      PendingAction[]
  imports      ImportBatch[]
  rules        Rule[]

  @@map("users")
}

model Session {
  /// Opaque random token; also the value of the session cookie.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AccountType {
  BANK
  EWALLET
  CASH
  CREDIT_CARD
  LOAN
  INVESTMENT
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  institution    String?
  currency       String      @default("IDR")
  openingBalance BigInt      @default(0)
  openingDate    DateTime    @db.Date
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  imports      ImportBatch[]
  rules        Rule[]

  @@unique([userId, name])
  @@map("accounts")
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id         String       @id @default(cuid())
  userId     String
  name       String
  kind       CategoryKind
  parentId   String?
  color      String?
  archivedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  rules        Rule[]
  stagedRows   StagedRow[]

  @@unique([userId, kind, name])
  @@map("categories")
}

enum TransactionSource {
  MANUAL
  IMPORT
  AGENT
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  accountId   String
  bookedOn    DateTime          @db.Date
  amount      BigInt
  description String
  payee       String?
  note        String?
  categoryId  String?
  transferId  String?
  importBatchId String?
  fingerprint String
  source      TransactionSource @default(MANUAL)
  /// MCP client name when an agent created the row.
  createdBy   String?
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([userId, bookedOn])
  @@index([accountId, bookedOn])
  @@index([accountId, fingerprint])
  @@index([transferId])
  @@index([importBatchId])
  @@map("transactions")
}

enum ActorKind {
  USER
  AGENT
}

/// Every write through the domain layer leaves one row here, from the UI or an agent.
model AuditLog {
  id         String    @id @default(cuid())
  userId     String
  actorKind  ActorKind
  /// MCP client name for agents, null for the UI.
  clientName String?
  action     String
  entity     String
  entityId   String
  before     Json?
  after      Json?
  at         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Bearer token for the MCP server and API. Only a sha256 of the secret is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// First characters of the token, shown in the UI so the user can tell tokens apart.
  prefix     String
  tokenHash  String    @unique
  /// Any of "read", "write", "destructive".
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// A destructive request waiting for `kasvo_confirm`. Nothing changes until it is consumed.
model PendingAction {
  id         String    @id @default(cuid())
  userId     String
  clientName String?
  tool       String
  payload    Json
  summary    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("pending_actions")
}

enum ImportStatus {
  /// Parsed rows are waiting for review.
  STAGED
  /// The file was not recognised; the user must map its columns.
  NEEDS_MAPPING
  COMMITTED
  REVERTED
  DISCARDED
}

model ImportBatch {
  id          String       @id @default(cuid())
  userId      String
  accountId   String
  /// Detected or chosen parser, e.g. "bca", "generic", "agent".
  format      String
  fileName    String?
  fileHash    String?
  /// Original file text, kept until commit so the user can re-map columns.
  rawContent  String?
  /// Column mapping used for "generic" CSV.
  mapping     Json?
  status      ImportStatus @default(STAGED)
  rowCount    Int          @default(0)
  duplicateCount Int       @default(0)
  committedCount Int       @default(0)
  createdAt   DateTime     @default(now())
  committedAt DateTime?
  createdBy   String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rows         StagedRow[]
  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([accountId, fileHash])
  @@map("import_batches")
}

model StagedRow {
  id          String    @id @default(cuid())
  batchId     String
  /// Position in the file, for stable ordering.
  line        Int
  bookedOn    DateTime  @db.Date
  amount      BigInt
  description String
  payee       String?
  fingerprint String
  /// True when the account already holds this transaction.
  duplicate   Boolean   @default(false)
  categoryId  String?
  /// Rule that suggested categoryId, if any.
  ruleId      String?
  /// User or agent decided to leave this row out.
  skip        Boolean   @default(false)

  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([batchId, line])
  @@map("staged_rows")
}

/// "When a transaction looks like this, give it that category." First match by priority wins.
model Rule {
  id            String        @id @default(cuid())
  userId        String
  priority      Int           @default(100)
  enabled       Boolean       @default(true)
  /// Case-insensitive substring of the normalised description or payee.
  contains      String
  kind          CategoryKind?
  accountId     String?
  minAmount     BigInt?
  maxAmount     BigInt?
  categoryId    String
  /// Optional payee to set when the rule matches.
  setPayee      String?
  createdAt     DateTime      @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
  @@map("rules")
}
